VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ADMIN_EMAILS=admin@example.com

# AI provider keys – SERVER-SIDE ONLY (never exposed to the browser).
# Set them as environment variables in Vercel (production) and in .env for the
# vite dev proxy. The legacy VITE_-prefixed names are still accepted locally.
OPENROUTER_API_KEY=your_openrouter_api_key
NVIDIA_API_KEY=your_nvidia_nim_api_key
